# Keep the build context small and the image reproducible. Without this, a
# developer's local `target/` (often several GB) is copied into the build and
# host-built artifacts can shadow the ones the image compiles.
#
# The release binary itself must stay: Dockerfile.prod is a slim runtime image
# whose whole job is `COPY target/release/api_switch .`, against a binary the
# deploy pipeline downloads from R2 into that path on the box. Excluding it
# breaks every staging and prod build with "/target/release/api_switch: not
# found", while leaving the self-host build (which compiles its own) unaffected.
target/
!target/release/api_switch
.git/

# Never bake a developer's local secrets into an image.
.env
.env.*
.gitignore
Dockerfile
.dockerignore
