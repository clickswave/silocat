# Silocat self-host configuration.
# Copy to .env at the repo root and fill in the required values:
#   cp env.selfhost.example .env
# Then start the stack:
#   docker compose -f orchestration/docker-compose.selfhost.yml --env-file .env up -d

# ---- required ----
# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me
# MinIO root password for the bundled object storage (also used as the S3 secret).
MINIO_ROOT_PASSWORD=change-me-too
# Secret used to sign session JWTs (any long random string).
JWT_SECRET=
# Shared secret between web_server and api_switch (any long random string).
INFRA_COMMUNICATION_SECRET=
# Admin gate. A single high-entropy secret sent as the `X-Admin-Secret` header.
# Generate with: openssl rand -hex 32
# Leave EMPTY to disable the admin surface entirely (it fails closed).
ADMIN_COMMUNICATION_SECRET=

# ---- wire protocol header names ----
# Which HTTP headers carry INFRA_COMMUNICATION_SECRET and ADMIN_COMMUNICATION_SECRET. Configurable so a
# deployment is not fingerprinted by the published source.
#
# These are NOT secrets. Anyone who observes one request learns them, and the
# AGPL means the source is public anyway. Changing them removes a little free
# reconnaissance; it is the secret VALUES that protect the surface. Every
# backend that talks to api_switch must agree on these.
INFRA_COMMUNICATION_SECRET_HEADER=X-Authority-Sign
ADMIN_COMMUNICATION_SECRET_HEADER=X-Admin-Secret

# ---- optional: turn features on by filling these in ----
# Cloudflare Turnstile (bot protection on signup/signin).
# The default test keys always pass; get real keys for a public instance.
PUBLIC_TURNSTILE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Outbound email (verification codes, password resets). Off when blank.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Silocat
SMTP_FROM_EMAIL=

# Google OAuth sign-in. Off when blank.
OAUTH_ID_GOOGLE=
OAUTH_SECRET_GOOGLE=
GOOGLE_REDIRECT_URI=
OAUTH_CALLBACK_BASE_URI=http://localhost:12001

# Razorpay billing (you almost certainly want this off when self-hosting).
RAZORPAY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GeoIP lookups. Download GeoLite2-City.mmdb from MaxMind (free license
# required, not redistributable) and set the container path here.
GEOLITE2_DB_PATH=

# Restrict signups to invited users (1 = invite only).
SILOCAT_INVITE_ONLY=0

# ---- storage overrides (defaults use the bundled MinIO) ----
# Point these at Cloudflare R2 / Backblaze B2 / any S3-compatible store instead.
# CF_R2_SHADOW_API_URL=
# CF_R2_SHADOW_BUCKET=
# CF_R2_SHADOW_ACCESS_ID=
# CF_R2_SHADOW_ACCESS_SECRET=
# (same trio for SANCTUM and DP buckets)

# ---- retention & housekeeping (WatchCat scheduler) ----
# WatchCat is the same api_switch binary run with WATCHCAT_MODE=1. It sweeps on
# an interval and enforces the retention the UI promises, so changing these
# changes what the app tells your users.

# How often the sweep runs. Default 900 (15 minutes).
# WATCHCAT_GC_INTERVAL_SECS=900

# Trash retention. Deleted files and folders are purged this many days after
# deletion; the Trash screen shows a live countdown against it. Floored at 1 so
# a misconfigured 0 cannot turn the trash into a shredder. Default 30.
# WATCHCAT_TRASH_TTL_DAYS=30

# Anonymous drop lifetime. Must agree with the copy on the landing page, the
# pricing footnote and the upload-success modal, which all promise seven days.
# Default 7.
# WATCHCAT_SHADOW_TTL_DAYS=7

# Abandoned-upload reaper: an upload that never finished is cleaned up after
# this many hours. Floored at 1 so in-progress uploads are never reaped.
# Default 2.
# WATCHCAT_GC_TTL_HOURS=2

# Rows processed per sweep, per job. Raise on a large instance. Default 200.
# WATCHCAT_GC_BATCH=200
